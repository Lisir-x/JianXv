{
  "name": "personal-todo",
  "productName": "笺序",
  "version": "1.0.0",
  "description": "离线个人待办与游戏活动提醒",
  "author": "Personal",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && node scripts/package-windows.cjs",
    "pack": "npm run build && node scripts/package-windows.cjs --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "luxon": "^3.7.2"
  },
  "build": {
    "appId": "Jianxu.PaperTaskbar",
    "productName": "笺序",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "assets/{icon,tray}.png",
      "!**/*.map",
      "!node_modules/better-sqlite3/{build,deps,src}/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/!(win32-x64.node)",
      "!node_modules/better-sqlite3/lib/{darwin,linux,linuxmusl}-*.js",
      "!node_modules/better-sqlite3/lib/win32-arm64.js",
      "!node_modules/node-addon-api/**",
      "!node_modules/luxon/src/**",
      "!node_modules/luxon/build/{amd,cjs-browser,es6,global}/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/win32-x64.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "guid": "c79f6fae-2fb7-5884-b678-ded7b129709a",
      "artifactName": "笺序 Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "allowElevation": false,
      "differentialPackage": false,
      "include": "scripts/installer.nsh"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "compression": "maximum",
    "asar": {
      "smartUnpack": false
    },
    "afterPack": "./scripts/trim-windows-package.cjs",
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "jianxu-taskbar.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "jianxu-notification.png"
      },
      {
        "from": "scripts/windows-reminder.ps1",
        "to": "windows-reminder.ps1"
      },
      {
        "from": "src/renderer/fonts/OFL-NotoSerifSC.txt",
        "to": "licenses/OFL-NotoSerifSC.txt"
      },
      {
        "from": "node_modules/react/LICENSE",
        "to": "licenses/react.txt"
      },
      {
        "from": "node_modules/react-dom/LICENSE",
        "to": "licenses/react-dom.txt"
      },
      {
        "from": "node_modules/scheduler/LICENSE",
        "to": "licenses/scheduler.txt"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-vite": "6.0.0",
    "vite": "8.3.8",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "vitest": "5.1.1",
    "@playwright/test": "1.65.1",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
